  "@types/pg": "^8.23.1",
  "@types/three": "^0.170.0",
  "@types/ws": "^8.18.2",
  "playwright": "^1.65.1",
  "tsx": "^4.23.15",
  "typescript": "^5.6.0",
  "vite": "^5.4.0",
  "vitest": "^2.1.0"
 }
}
